{
  "name": "@fabric/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FabriC++ localhost-only, session-only browser prototype. Not a production client.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test test/policy.test.ts test/shutdown.test.ts test/logger.test.ts test/identity-guard.test.ts test/crypto-memory.test.ts test/ui.test.tsx test/source-guards.test.ts",
    "test:integration": "node --import tsx --test --test-force-exit --test-timeout 300000 test/e2ee.integration.test.ts"
  },
  "dependencies": {
    "@matrix-org/matrix-sdk-crypto-wasm": "18.9.0",
    "matrix-js-sdk": "45.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "happy-dom": "^20.0.11",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vite": "^7.1.12"
  },
  "overrides": {
    "@matrix-org/matrix-sdk-crypto-wasm": "18.9.0"
  }
}
